# AI Service -- LLM provider credentials. Copy this file to `.env` (gitignored)
# and fill in the keys you have. A provider with no key can still be selected
# in the code but every analysis attempt using it will fail gracefully and be
# recorded as status "failed" rather than crashing the service.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Channel Service -- Gmail SMTP for the email connector. If left blank,
# email dispatch fails gracefully (status "failed") rather than crashing.
# Gmail requires an App Password if 2-Step Verification is on -- a regular
# account password will be rejected. Generate one at
# myaccount.google.com/apppasswords.
# SMTP_USER must be the real mailbox address (used for SMTP auth) --
# SMTP_FROM_NAME is what recipients see as the display name instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
