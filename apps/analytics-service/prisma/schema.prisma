generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DailyEventStat {
  id        String @id @default(uuid())
  tenantId  String
  date      String
  eventType String
  source    String @default("")
  count     Int    @default(0)

  @@unique([tenantId, date, eventType, source])
  @@index([tenantId, date])
}

model DailyNotificationStat {
  id       String @id @default(uuid())
  tenantId String
  date     String
  channel  String
  sent     Int    @default(0)
  failed   Int    @default(0)

  @@unique([tenantId, date, channel])
  @@index([tenantId, date])
}
